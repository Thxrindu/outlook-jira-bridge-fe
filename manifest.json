{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.24/MicrosoftTeams.schema.json",
  "manifestVersion": "1.24",
  "version": "1.0.0",
  "id": "c3f6e865-8761-4701-bfd8-91782112ab9e",

  "localizationInfo": {
    "defaultLanguageTag": "en-us",
    "additionalLanguages": []
  },

  "developer": {
    "name": "THARINDU SAMARAKOON",
    "websiteUrl": "https://thxrindu.github.io/portfolio",
    "privacyUrl": "https://thxrindu.github.io/portfolio/privacy",
    "termsOfUseUrl": "https://thxrindu.github.io/portfolio/terms"
  },

  "name": {
    "short": "Outlook Jira Bridge",
    "full": "Outlook Jira Bridge"
  },

  "description": {
    "short": "Create Jira issues directly from Outlook emails",
    "full": "Create Jira issues directly from Outlook emails."
  },

  "icons": {
    "outline": "assets/outline.png",
    "color": "assets/color.png"
  },

  "accentColor": "#230201",

  "validDomains": [
    "localhost",
    "auth.atlassian.com",
    "thxrindu.github.io",
    "outlook-jira-bridge-be-production.up.railway.app"
  ],

  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "MailboxItem.ReadWrite.User",
          "type": "Delegated"
        }
      ]
    }
  },

  "extensions": [
    {
      "requirements": {
        "capabilities": [
          {
            "name": "Mailbox",
            "minVersion": "1.3"
          }
        ],
        "scopes": ["mail"]
      },

      "runtimes": [
        {
          "id": "TaskPaneRuntime",
          "type": "general",

          "code": {
            "page": "https://localhost:3000/taskpane.html"
          },

          "lifetime": "short",

          "actions": [
            {
              "id": "TaskPaneRuntimeShow",
              "type": "openPage",
              "pinnable": false
            }
          ]
        }
      ],

      "ribbons": [
        {
          "contexts": ["mailCompose"],

          "tabs": [
            {
              "builtInTabId": "TabDefault",

              "groups": [
                {
                  "id": "outlookJiraBridgeGroup",
                  "label": "Outlook Jira Bridge",

                  "icons": [
                    {
                      "size": 16,
                      "url": "https://localhost:3000/assets/icon-16.png"
                    },
                    {
                      "size": 32,
                      "url": "https://localhost:3000/assets/icon-32.png"
                    },
                    {
                      "size": 80,
                      "url": "https://localhost:3000/assets/icon-80.png"
                    }
                  ],

                  "controls": [
                    {
                      "id": "openJiraBridgeButton",
                      "type": "button",
                      "label": "Open Outlook Jira Bridge",

                      "icons": [
                        {
                          "size": 16,
                          "url": "https://localhost:3000/assets/icon-16.png"
                        },
                        {
                          "size": 32,
                          "url": "https://localhost:3000/assets/icon-32.png"
                        },
                        {
                          "size": 80,
                          "url": "https://localhost:3000/assets/icon-80.png"
                        }
                      ],

                      "supertip": {
                        "title": "Outlook Jira Bridge",
                        "description": "Open Outlook Jira Bridge"
                      },

                      "actionId": "TaskPaneRuntimeShow"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
